# Copy to .env. No secrets here besides the shared ingest key used to authenticate to
# the backend — never commit the real .env.

HOST=0.0.0.0
PORT=8000

# Which adapter each pipeline stage uses. See docs/ai-pipeline.md for what each one
# actually is (real model vs. clearly-labeled demo/mock).
DETECTION_ADAPTER=yolov8          # yolov8 (real) | mock
WEAPON_ADAPTER=yolov8             # yolov8 (real, gun/knife fine-tune) or mock -- see models/README.md for setup
ACTION_ADAPTER=demo_heuristic      # demo_heuristic only today
CAPTION_ADAPTER=template           # template only today
THREAT_ADAPTER=rule_based          # rule_based only today

# YOLOv8 model file — auto-downloaded by ultralytics into ./models on first run if
# not already present. See ../models/README.md.
YOLO_MODEL_PATH=../models/yolov8s.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
WEAPON_MODEL_PATH=../models/best.pt
WEAPON_CONFIDENCE_THRESHOLD=0.6

# Rolling frame-window size (seconds) used for action recognition / threat analysis.
SEQUENCE_WINDOW_SECONDS=6

# Backend ingestion endpoint (see backend/src/routes/inference.routes.ts) and the
# shared secret it expects in the `x-ingest-key` header — must match backend's
# INGEST_API_KEY exactly.
BACKEND_URL=http://localhost:4000
INGEST_API_KEY=replace-with-a-long-random-string
